{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "declaration": true,
    "outDir": "dist", "rootDir": ".", "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
