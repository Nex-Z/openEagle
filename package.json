{
  "name": "open-eagle",
  "private": true,
  "version": "0.2.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:backend": "pnpm --filter @open-eagle/backend dev",
    "dev:desktop": "node scripts/electron-dev.cjs",
    "dev:desktop:external-backend": "node scripts/electron-dev-external-backend.cjs",
    "dev:stack": "node scripts/dev-stack.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.cjs",
    "backend:sidecar": "node scripts/build-sidecar.cjs",
    "electron:build": "pnpm --filter @open-eagle/agent-core build && tsc -p tsconfig.electron.json && node scripts/ensure-cjs-package.cjs && vite build && electron-builder --publish never",
    "electron:build:win": "pnpm --filter @open-eagle/agent-core build && pnpm uia:build && tsc -p tsconfig.electron.json && node scripts/ensure-cjs-package.cjs && vite build && electron-builder --win --publish never",
    "electron:build:mac": "pnpm --filter @open-eagle/agent-core build && tsc -p tsconfig.electron.json && node scripts/ensure-cjs-package.cjs && vite build && electron-builder --mac --publish never",
    "electron:build:linux": "pnpm --filter @open-eagle/agent-core build && tsc -p tsconfig.electron.json && node scripts/ensure-cjs-package.cjs && vite build && electron-builder --linux --publish never",
    "package:desktop": "pnpm backend:sidecar && pnpm electron:build",
    "package:windows": "pnpm backend:sidecar && pnpm electron:build:win",
    "package:mac": "pnpm backend:sidecar && pnpm electron:build:mac",
    "package:linux": "pnpm backend:sidecar && pnpm electron:build:linux",
    "v2:typecheck": "pnpm --filter @open-eagle/agent-core typecheck",
    "v2:test": "pnpm --filter @open-eagle/agent-core test",
    "v2:demo": "pnpm --filter @open-eagle/agent-core demo",
    "v2:test:ui": "node scripts/verify-v2-fixture.cjs",
    "v2:test:pi-ui": "node scripts/verify-v2-pi-session.cjs",
    "v2:test:gui": "node scripts/verify-v2-gui.cjs",
    "v2:test:gui-policy": "tsc -p tsconfig.electron.json && node scripts/ensure-cjs-package.cjs && node --test scripts/verify-v2-gui-policy.cjs",
    "v2:test:gui:manual": "node scripts/start-v2-gui-manual.cjs",
    "uia:build": "node scripts/build-windows-uia.cjs",
    "v2:test:uia:plan": "node scripts/verify-v2-uia.cjs --plan",
    "v2:test:uia:owned": "node scripts/verify-v2-uia.cjs --run-owned-window"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tanstack/react-virtual": "^3.14.2",
    "classic-level": "^3.0.0",
    "lucide-react": "^1.11.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@open-eagle/agent-core": "workspace:*",
    "openai": "7.19.0",
    "@nut-tree-fork/shared": "4.2.6",
    "@nut-tree-fork/provider-interfaces": "4.2.6",
    "@jimp/plugins": "0.22.12",
    "@jimp/plugin-print": "0.22.12",
    "@jimp/plugin-rotate": "0.22.12",
    "@jimp/plugin-scale": "0.22.12",
    "@jimp/plugin-shadow": "0.22.12",
    "@jimp/plugin-threshold": "0.22.12",
    "@jimp/plugin-contain": "0.22.12",
    "@jimp/plugin-cover": "0.22.12",
    "@jimp/plugin-flip": "0.22.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.1"
  }
}
